# Copy to .env for local development and fill in. Never commit .env. Placeholders only: no real value belongs in this file.
#
# Variables are grouped by WHERE they are needed (see docs/deployment.md for the full table and the production rules):
#   [build]  read by `next build` (NEXT_PUBLIC_* is inlined into the browser bundle: set it at BUILD time)
#   [web]    read by the web process (`next start`)
#   [worker] read by the background worker (`npm run worker`)
#   [both]   the same value for web and worker
#   [test]   only the test suite
#   [opt]    optional: has a default, or the feature is simply off
# In production the web process and the worker refuse to start when a required variable is missing (src/lib/runtime-config.ts).

NODE_ENV=development
LOG_LEVEL=info                      # [opt] fatal|error|warn|info|debug|trace|silent

# ---- Required in production -------------------------------------------------------------------------------------------

# [both] PostgreSQL with the pgvector extension (docker compose up -d provides this locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ops?schema=public

# [both] Redis: the BullMQ queue and realtime fan-out. The web process and the worker MUST share it.
REDIS_URL=redis://localhost:6379

# [web] Clerk (https://dashboard.clerk.com -> API keys). The secret key is server-only; never expose it.
CLERK_SECRET_KEY=sk_test_placeholder
# [build + web] Inlined into the browser bundle at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# [both] Gemini (https://aistudio.google.com/apikey). Server-only: never expose via NEXT_PUBLIC_*.
# Optional in development (AI features answer 503 without it); required in production.
GEMINI_API_KEY=

# ---- Optional ---------------------------------------------------------------------------------------------------------

# [opt] Overrides; defaults live in src/server/ai/config.ts.
# GEMINI_GENERATION_MODEL=
# GEMINI_EMBEDDING_MODEL=
# RAG_MIN_SIMILARITY=0.6
# AI_TOOLS_ENABLED=true

# [opt] bullmq (default when REDIS_URL is set) or memory (in-process, development only: refused in production).
# AUTOMATION_QUEUE_DRIVER=bullmq
# [opt] redis (default when REDIS_URL is set) or memory (single process, development only: refused in production).
# REALTIME_DRIVER=redis

# [web] "true" makes browsers REPORT Content-Security-Policy violations instead of blocking them (a safe first deployment).
# CSP_REPORT_ONLY=false

# [both] Email channel. Keep BOTH unset in any deployment: the only provider is "fake" (an in-memory test double), which is
# refused in production, and no real provider is implemented. See docs/email-provider-readiness.md.
# EMAIL_PROVIDER=fake
# EMAIL_PLATFORM_DOMAIN=mail.example.com
# Outbound email limits (defaults shown; hard ceilings 600 / 100000 / 120 / 100). Enforced in the database, per organization.
# EMAIL_OUTBOUND_ORG_PER_MINUTE=30
# EMAIL_OUTBOUND_ORG_PER_DAY=1000
# EMAIL_OUTBOUND_USER_PER_MINUTE=20
# EMAIL_OUTBOUND_RECIPIENT_PER_HOUR=10

# ---- Tests only (never read by the application) -----------------------------------------------------------------------

# [test] A migrated PostgreSQL database. The tests TRUNCATE it: use a throwaway database, never a shared one.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ops_test
# [test] A THROWAWAY Redis database 15 (the real-BullMQ tests flush it).
# TEST_REDIS_URL=redis://localhost:6379/15

# ---- Planned integrations (not consumed by any code yet) ----------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
