# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose up -d provides this locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ops?schema=public

# Redis (BullMQ) - used from the background-jobs milestone
REDIS_URL=redis://localhost:6379

