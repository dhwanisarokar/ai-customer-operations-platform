generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// Application identity, linked to the external auth provider (Clerk). We never store credentials.
model User {
  id             String   @id @default(uuid()) @db.Uuid
  authProviderId String   @unique
  email          String   @unique
  name           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships               Membership[]
  notes                     CustomerNote[]
  messages                  Message[]
  createdKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeCreatedBy")
  updatedKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeUpdatedBy")

  @@map("users")
}

// Tenant root. Every organization-owned table added later carries an
// `organizationId` foreign key to this table (see docs/decisions/003-tenant-isolation.md).
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  customers          Customer[]
  tags               Tag[]
  activities         CustomerActivity[]
  notes              CustomerNote[]
  customerTags       CustomerTag[]
  conversations      Conversation[]
  messages           Message[]
  conversationEvents ConversationEvent[]
  readStates         ConversationReadState[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeDocumentChunk[]
  aiActionApprovals  AiActionApproval[]
  aiToolAudits       AiToolAudit[]
  automations        Automation[]
  automationRuns     AutomationExecution[]
  widgetSettings     WidgetSettings?
  visitorSessions    VisitorSession[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations  Conversation[]
  conversationReadStates ConversationReadState[]

  // One membership per (user, organization). Also serves "is user in org?" lookups and
  // "list a user's organizations" (leading column userId).
  @@unique([userId, organizationId])
  // "List an organization's members" (leading column organizationId), optionally by role.
  @@index([organizationId, role])
  @@map("memberships")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ActivityType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  TAG_ADDED
  TAG_REMOVED
  NOTE_ADDED
}

enum ActivityActorType {
  USER
  SYSTEM
  AI
  // A website visitor (widget session); actorId is the visitor session id.
  CUSTOMER
}

// Tenant-owned. Child tables reference (id, organizationId) with composite foreign keys, so the
// database itself guarantees that a note/activity/tag link can never cross organizations.
model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  externalId     String?
  firstName      String
  lastName       String?
  // Lowercased and trimmed by the application. NULL when unknown (NULLs never collide).
  email          String?
  // Normalized by the application: optional leading "+" followed by digits only.
  phone          String?
  company        String?
  jobTitle       String?
  status         CustomerStatus @default(ACTIVE)
  source         String?
  metadata       Json?
  // Denormalized timestamp of the newest activity; maintained in the same transaction as the
  // activity insert. Lets the list show/sort "last activity" without joining the timeline.
  lastActivityAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  // Set explicitly on profile edits (not @updatedAt) so activity bookkeeping such as lastActivityAt
  // never counts as a profile modification.
  updatedAt      DateTime       @default(now())
  archivedAt     DateTime?

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tags            CustomerTag[]
  activities      CustomerActivity[]
  notes           CustomerNote[]
  conversations   Conversation[]
  visitorSessions VisitorSession[]

  // Business rules are tenant-aware: the same email/externalId may exist in different organizations.
  @@unique([organizationId, email])
  @@unique([organizationId, externalId])
  // Target of composite foreign keys from child tables.
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([organizationId, lastActivityAt(sort: Desc)])
  @@index([organizationId, firstName, lastName])
  @@map("customers")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  // Lowercased name; makes uniqueness case-insensitive ("VIP" == "vip") with a plain constraint.
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    CustomerTag[]

  @@unique([organizationId, normalizedName])
  @@unique([id, organizationId])
  @@map("tags")
}

model CustomerTag {
  customerId     String   @db.Uuid
  tagId          String   @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Duplicate links are impossible; the composite FKs make cross-tenant links impossible.
  @@id([customerId, tagId])
  // "Customers with tag X" (filtering) within an organization.
  @@index([organizationId, tagId])
  @@map("customer_tags")
}

model CustomerActivity {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  customerId     String            @db.Uuid
  type           ActivityType
  title          String
  description    String?
  metadata       Json?
  actorType      ActivityActorType @default(USER)
  // User id for USER actors; null for SYSTEM. Deliberately not a foreign key: future actors
  // (AI agents, workflows) are not users, and history must outlive user deletion.
  actorId        String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Timeline: newest-first activities of one customer.
  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@map("customer_activities")
}

model CustomerNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  customerId     String   @db.Uuid
  // Nullable so notes survive deletion of their author.
  authorId       String?  @db.Uuid
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@map("customer_notes")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Only IN_APP exists today. Adding EMAIL, WHATSAPP, ... later is an additive enum migration.
enum ConversationChannel {
  IN_APP
  // A visitor of an organization's embedded web chat widget (Phase 7).
  WEB_CHAT
}

enum MessageSenderType {
  CUSTOMER
  USER
  SYSTEM
  AI_AGENT
}

// INTERNAL_NOTE is a staff-only note. Customer-facing history is MESSAGE rows only.
enum MessageType {
  MESSAGE
  INTERNAL_NOTE
}

enum ConversationEventType {
  CONVERSATION_CREATED
  SUBJECT_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  MESSAGE_SENT
  INTERNAL_NOTE_ADDED
  HUMAN_REQUESTED
  // Automatic customer-facing AI replies switched on/off for the conversation (AI <-> HUMAN).
  HANDLING_MODE_CHANGED
}

// Who may answer the visitor of a web chat conversation: the customer-facing AI (AI) or only people
// (HUMAN). Distinct from status (lifecycle), assignee (owner) and humanRequestedAt (the visitor asked
// for a person). Enforced server-side before an AI job is queued, when it runs, and atomically when the
// reply is stored.
enum ConversationHandlingMode {
  AI
  HUMAN
}

// Tenant-owned. Composite foreign keys keep it in one organization:
//  - (customerId, organizationId)         -> customers(id, organizationId)
//  - (assignedToUserId, organizationId)   -> memberships(userId, organizationId): the assignee must
//    be a member of the same organization. NO ACTION (not SET NULL): removing a member first
//    unassigns their conversations in the application (see removeMember).
model Conversation {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @db.Uuid
  customerId       String                   @db.Uuid
  subject          String
  status           ConversationStatus       @default(OPEN)
  priority         ConversationPriority     @default(NORMAL)
  channel          ConversationChannel      @default(IN_APP)
  handlingMode     ConversationHandlingMode @default(HUMAN)
  assignedToUserId String?                  @db.Uuid
  // WEB_CHAT conversations belong to exactly one visitor session. A conversation id alone never
  // authorizes a visitor: the session must match this column.
  visitorSessionId String?                  @db.Uuid
  // Set when the visitor asked for a person; cleared when someone is assigned (the "handoff").
  humanRequestedAt DateTime?

  // Denormalized from the newest customer-facing message so the inbox list needs no message join.
  // Internal notes never touch these. Maintained in the same transaction as the message insert.
  lastMessageAt         DateTime
  lastMessagePreview    String?
  lastMessageSenderType MessageSenderType?
  // Newest CUSTOMER message; drives the per-member unread indicator.
  lastCustomerMessageAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  closedAt  DateTime?

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer                @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee       Membership?             @relation(fields: [assignedToUserId, organizationId], references: [userId, organizationId], onDelete: NoAction)
  visitorSession VisitorSession?         @relation(fields: [visitorSessionId, organizationId], references: [id, organizationId], onDelete: NoAction)
  messages       Message[]
  events         ConversationEvent[]
  aiApprovals    AiActionApproval[]
  readStates     ConversationReadState[]

  @@unique([id, organizationId])
  // A visitor's own conversations, newest first.
  @@index([organizationId, visitorSessionId, lastMessageAt(sort: Desc)])
  // Inbox tabs: status filter, newest activity first.
  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  // "All" view and default sort.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  // "Assigned to me" / per-assignee views.
  @@index([organizationId, assignedToUserId, status])
  // Priority views (High, Urgent are first-class inbox filters).
  @@index([organizationId, priority, lastMessageAt(sort: Desc)])
  // Customer 360 conversation list.
  @@index([organizationId, customerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  conversationId  String            @db.Uuid
  senderType      MessageSenderType
  // Set only for USER senders. Nullable + SET NULL so history survives user deletion.
  senderUserId    String?           @db.Uuid
  messageType     MessageType       @default(MESSAGE)
  body            String
  // Client-generated id of a widget message: retrying the same send can never create a duplicate.
  clientMessageId String?
  // AI messages: provider, model, prompt version, sources, usage (see docs/ai-agent.md). Never
  // contains prompts, API keys or other secrets. NULL for human and customer messages.
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sender       User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, clientMessageId])
  // Timeline pages of one conversation in chronological order (and the reverse for "latest N").
  @@index([organizationId, conversationId, createdAt, id])
  @@map("messages")
}

model ConversationEvent {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  conversationId String                @db.Uuid
  type           ConversationEventType
  metadata       Json?
  actorType      ActivityActorType     @default(USER)
  // User id for USER actors. Not a foreign key (future AI/system actors; history outlives users).
  actorId        String?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, conversationId, createdAt, id])
  @@map("conversation_events")
}

// Per-member read state: one row per (conversation, member) holding when they last opened it.
// A conversation is unread for a member when lastCustomerMessageAt is newer than their lastReadAt
// (or they have no row). Cascades with the membership, so leaving an organization cleans it up.
model ConversationReadState {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  lastReadAt     DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership   Membership   @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_read_states")
}

enum KnowledgeDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Tenant-owned knowledge article. Only PUBLISHED documents are searchable by the AI.
model KnowledgeDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  title           String
  description     String?
  content         String
  status          KnowledgeDocumentStatus @default(DRAFT)
  // Incremented whenever title/content change. Chunks record the version they were built from, so
  // a chunk that does not match its document's version can never be retrieved.
  contentVersion  Int                     @default(1)
  publishedAt     DateTime?
  createdByUserId String?                 @db.Uuid
  updatedByUserId String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("KnowledgeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?                    @relation("KnowledgeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  chunks       KnowledgeDocumentChunk[]

  @@unique([id, organizationId])
  // Knowledge list: status filter, most recently updated first.
  @@index([organizationId, status, updatedAt(sort: Desc)])
  // Knowledge list without a status filter.
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("knowledge_documents")
}

// One embedded slice of a document. The embedding column is a pgvector vector(768); Prisma cannot
// read or write it, so chunks are written and searched with reviewed raw SQL
// (src/server/repositories/knowledge-chunks.ts). The composite foreign key keeps a chunk in the
// same organization as its document.
model KnowledgeDocumentChunk {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String                     @db.Uuid
  documentId      String                     @db.Uuid
  chunkIndex      Int
  content         String
  // Estimated from character count (about 4 characters per token); not a tokenizer result.
  estimatedTokens Int
  contentVersion  Int
  embedding       Unsupported("vector(768)")
  createdAt       DateTime                   @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Stable ordering and "replace all chunks of a document".
  @@unique([documentId, chunkIndex])
  // Tenant scan for vector search (exact search over one organization's chunks) and per-document
  // deletes. See docs/rag.md for why there is deliberately no ANN (HNSW/IVFFlat) index yet.
  @@index([organizationId, documentId])
  @@map("knowledge_document_chunks")
}

// ---- AI tools: approvals and audit (Phase 5) ---------------------------------------------------

enum AiToolRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// PENDING -> APPROVED -> EXECUTED | FAILED; PENDING -> REJECTED | EXPIRED. Terminal states never
// change again (enforced by guarded updates in the application and CHECK constraints).
enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum AiToolAuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  APPROVAL_REQUESTED
}

// A mutation proposed by the AI that a human must approve before application code executes it.
// Stores the VALIDATED tool input and a display preview built by the application, never prompts or
// model reasoning. User ids are plain columns (history outlives users, like event actors).
model AiActionApproval {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  conversationId    String?          @db.Uuid
  requestedByUserId String           @db.Uuid
  toolName          String
  input             Json
  // What the approver sees: { title, lines: [{ label, from, to }] }. Computed by the application.
  preview           Json
  riskLevel         AiToolRiskLevel
  status            AiApprovalStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  expiresAt         DateTime
  approvedAt        DateTime?
  approvedByUserId  String?          @db.Uuid
  rejectedAt        DateTime?
  rejectedByUserId  String?          @db.Uuid
  executedAt        DateTime?
  // Safe error code only (e.g. EXECUTION_FAILED); never raw database or provider errors.
  failureCode       String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, conversationId, status, createdAt(sort: Desc)])
  @@index([organizationId, status, expiresAt])
  @@map("ai_action_approvals")
}

// One row per tool execution attempt (reads, approved mutations, denials, approval requests).
// No inputs, results or prompts: only who/what/outcome.
model AiToolAudit {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  conversationId String?            @db.Uuid
  actorUserId    String             @db.Uuid
  toolName       String
  riskLevel      AiToolRiskLevel
  approvalId     String?            @db.Uuid
  outcome        AiToolAuditOutcome
  errorCode      String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, approvalId])
  @@map("ai_tool_audits")
}

// ---- Automations (Phase 6) -------------------------------------------------------------------

enum AutomationExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// "WHEN <trigger> AND <conditions> THEN <actions>". Deterministic rules, no model involved.
// `conditions` and `actions` are validated with Zod against the trigger/action registries on every
// write; JSON is used only for those two ordered lists. The creator's permissions are re-checked
// each time the automation runs.
model Automation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  description     String?
  enabled         Boolean  @default(true)
  triggerType     String
  conditions      Json
  actions         Json
  // Plain column (history outlives users); the run executes with this member's current role.
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@unique([id, organizationId])
  @@index([organizationId, enabled, triggerType])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("automations")
}

// One row per (automation, domain event). The unique key is the idempotency guarantee: the same
// event can never create (or run) a second execution of the same automation. The definition is
// snapshotted so history stays understandable after the automation is edited, and so the worker
// runs exactly what matched.
model AutomationExecution {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @db.Uuid
  automationId     String                    @db.Uuid
  eventId          String                    @db.Uuid
  eventType        String
  status           AutomationExecutionStatus @default(QUEUED)
  attempts         Int                       @default(0)
  createdAt        DateTime                  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  // Set while a worker owns the run; a stale lock (crashed worker) can be taken over.
  lockedAt         DateTime?
  // Safe error code/message only (never raw database or provider errors).
  errorCode        String?
  errorMessage     String?
  // Minimal event data (ids and enum values; sensitive fields such as message text are dropped).
  eventData        Json
  // { name, conditions, actions } as they were when the event matched.
  definition       Json
  // [{ field, operator, expected, actual?, passed }]
  conditionResults Json
  // [{ index, action, status, startedAt, completedAt, error? }] updated after each action.
  actionResults    Json                      @default("[]")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, automationId, eventId])
  @@index([organizationId, automationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("automation_executions")
}

// ---- Web chat widget (Phase 7) -----------------------------------------------------------------

// One per organization. `publicKey` is the PUBLIC identifier embedded in the website snippet: it
// selects the organization for anonymous visitors but is not a secret and grants nothing by itself
// (a visitor still needs a session). The organization is always derived from it on the server.
model WidgetSettings {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @unique @db.Uuid
  publicKey        String   @unique
  enabled          Boolean  @default(false)
  displayName      String
  welcomeMessage   String
  // #rrggbb, or null to use the application's theme color.
  accentColor      String?
  // Websites allowed to frame the widget (CSP frame-ancestors). Empty = any website.
  allowedOrigins   String[] @default([])
  // Customer-facing AI: when true, visitor messages get an automatic, read-only AI answer (until a
  // person takes over). Off by default; an organization opts in.
  aiRepliesEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("widget_settings")
}

// An anonymous visitor of ONE organization's widget. NOT a user and never a member: it can only
// reach its own conversations through the dedicated /api/widget API. The bearer token is random,
// shown to the browser once and stored only as a SHA-256 hash.
model VisitorSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  // Resolved by the server (never chosen by the client): a placeholder customer for an anonymous
  // visitor, or the organization's customer with the email the visitor gave.
  customerId     String?   @db.Uuid
  tokenHash      String    @unique
  visitorName    String?
  visitorEmail   String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  conversations Conversation[]

  @@unique([id, organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, expiresAt])
  @@map("visitor_sessions")
}
