generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tenant root. Every organization-owned table added later carries an
// `organizationId` foreign key to this table (see docs/decisions/003-tenant-isolation.md).
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}
